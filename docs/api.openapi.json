{
  "openapi": "3.1.0",
  "info": {
    "title": "lamp-rf-bridge HTTP API",
    "version": "unreleased",
    "description": "Local gateway, no confirmed lamp feedback. / 局域网网关，无已确认灯具回传。",
    "license": {
      "name": "MIT (project source only)"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "deviceCookie": []
    },
    {
      "digest": []
    }
  ],
  "paths": {
    "/api/session": {
      "get": {
        "summary": "Probe session / 探测会话",
        "parameters": [
          {
            "name": "X-Lamp-Web",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Use JSON 401, no native auth popup. / 返回 JSON 401，不弹系统认证框。"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "authenticated": {
                          "const": false
                        }
                      },
                      "required": [
                        "authenticated"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/Status"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "deviceCookie": []
          },
          {
            "digest": []
          }
        ]
      }
    },
    "/api/login/challenge": {
      "get": {
        "summary": "Issue one-use challenge / 签发一次性挑战",
        "parameters": [
          {
            "name": "X-Lamp-Web",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Use JSON 401, no native auth popup. / 返回 JSON 401，不弹系统认证框。"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginChallenge"
                }
              }
            }
          },
          "403": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/session/login": {
      "post": {
        "summary": "Consume challenge and log in / 消耗挑战并登录",
        "parameters": [
          {
            "name": "X-Lamp-Web",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Use JSON 401, no native auth popup. / 返回 JSON 401，不弹系统认证框。"
          },
          {
            "name": "X-Lamp-CSRF",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Boot CSRF; login uses its one-use challenge CSRF. / 启动周期 CSRF；登录使用一次性挑战 CSRF。"
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResult"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly; SameSite=Strict; Path=/; remembered adds Max-Age. / 持久信任另加 Max-Age。",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "remember": {
                    "type": "string",
                    "enum": [
                      "0",
                      "1"
                    ]
                  }
                },
                "required": [
                  "remember"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "security": [
          {
            "digest": []
          }
        ],
        "description": "Digest must use the exact nonce from GET /api/login/challenge and bind this POST URI. / Digest 须使用挑战签发的 nonce 并绑定此 POST URI。"
      }
    },
