              }
            }
          },
          "429": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/CommandResult"
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "JSON response / JSON 响应",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/CommandResult"
                    }
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CommandInput"
              }
            }
          }
        }
      }
    },
