  },
  "components": {
    "securitySchemes": {
      "deviceCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "lamp_device"
      },
      "digest": {
        "type": "http",
        "scheme": "digest"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          },
          "message": {
            "type": "string",
            "description": "Chinese device message. / 中文设备提示。"
          }
        },
        "required": [
          "ok",
          "message"
        ],
        "additionalProperties": false
      },
      "LoginChallenge": {
        "type": "object",
        "properties": {
          "realm": {
            "const": "Lamp Bridge"
          },
          "nonce": {
            "type": "string",
            "description": "Signed, per-boot, 72 hex characters. / 本次启动签名，72 位十六进制。",
            "minLength": 72,
            "maxLength": 72
          },
          "opaque": {
            "type": "string",
            "description": "Boot opaque. / 启动周期 opaque。"
          },
          "csrf": {
            "type": "string",
            "description": "One-use challenge CSRF. / 一次性挑战 CSRF。"
          }
        },
        "required": [
          "realm",
          "nonce",
          "opaque",
          "csrf"
        ]
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "trusted_device": {
            "type": "boolean",
            "description": "Persistent trust status. / 持久信任状态。"
          }
        },
        "required": [
          "ok",
          "trusted_device"
        ]
      },
      "WifiResult": {
        "type": "object",
        "properties": {
          "ok": {
            "const": true
          },
          "message": {
            "type": "string",
            "description": "Saved and connecting. / 已保存并连接中。"
          }
        },
        "required": [
          "ok",
          "message"
        ]
      },
      "CommandInput": {
        "type": "object",
        "properties": {
          "button": {
            "type": "string",
            "enum": [
              "power",
              "brightness_up",
              "brightness_down",
              "cct_up",
              "cct_down",
              "night_mode",
              "timer_10min"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "",
            "pattern": "^[0-9a-f]{16,48}$"
          }
        },
        "required": [
          "button",
          "request_id"
        ],
        "additionalProperties": false
      },
      "WifiInput": {
        "type": "object",
        "properties": {
          "ssid": {
            "type": "string",
            "description": "1..32 UTF-8 bytes, no control characters. / 1..32 UTF-8 字节，拒绝控制字符。"
          },
          "password": {
            "type": "string",
            "description": "Empty or 8..63 UTF-8 bytes, no control characters. / 为空或 8..63 UTF-8 字节，拒绝控制字符。"
          }
        },
        "required": [
          "ssid",
          "password"
        ],
        "additionalProperties": false
      },
      "CommandResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "description": ""
          },
          "message": {
            "type": "string",
            "description": "Chinese outcome. / 中文结果。"
          },
          "button": {
            "type": "string",
            "enum": [
              "power",
              "brightness_up",
              "brightness_down",
              "cct_up",
              "cct_down",
              "night_mode",
              "timer_10min"
            ]
          },
          "attempt": {
            "type": "integer",
            "description": "Actual boot-local TX attempts. / 启动周期实际发射尝试。"
          },
          "cooldown_ms": {
            "type": "integer",
            "description": "Remaining milliseconds. / 剩余毫秒。"
          },
          "radio_elapsed_us": {
            "type": "integer",
            "description": "TX elapsed microseconds, zero when not sent. / 发射微秒耗时，未发射时为零。"
          },
          "frames": {
            "type": "integer",
            "description": "Configured repetitions. / 配置重复数。"
          },
          "lamp_state_confirmed": {
            "const": false
          }
        },
        "required": [
          "ok",
          "message",
          "button",
          "attempt",
          "cooldown_ms",
          "radio_elapsed_us",
          "frames",
          "lamp_state_confirmed"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "authenticated": {
            "const": true
          },
          "phase": {
            "const": 4
          },
          "csrf": {
            "type": "string",
            "description": "Boot mutation CSRF. / 启动周期修改操作 CSRF。"
          },
          "auth": {
            "type": "object",
            "properties": {
              "trusted_device": {
                "type": "boolean",
                "description": "Valid persistent Cookie. / 有效持久 Cookie。"
              }
            },
            "required": [
              "trusted_device"
            ]
          },
          "http": {
            "type": "object",
            "properties": {
              "idle_preconnect_closed": {
                "type": "integer",
                "description": "Boot guard count. / 启动周期保护计数。"
              }
            },
            "required": [
              "idle_preconnect_closed"
            ]
          },
          "rf": {
            "type": "object",
            "properties": {
              "ready": {
                "type": "boolean",
                "description": "Gateway readiness, not lamp state. / 网关就绪，不是灯具状态。"
              },
              "marcstate": {
                "type": "integer",
