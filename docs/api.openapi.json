    "/api/session/forget": {
      "post": {
        "summary": "Revoke trust and issue RAM session / 撤销信任并签发 RAM 会话",
        "parameters": [
          {
            "name": "X-Lamp-Web",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Use JSON 401, no native auth popup. / 返回 JSON 401，不弹系统认证框。"
          },
          {
            "name": "X-Lamp-CSRF",
            "in": "header",
